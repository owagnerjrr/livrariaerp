# Copie para .env ou execute npm run setup:env (gera segredos locais aleatórios).
DATABASE_URL=postgresql://caramelo:CHANGE_ME@127.0.0.1:5432/caramelo
POSTGRES_USER=caramelo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=caramelo
PORT=3333
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_HOURS=8
SEED_DEMO_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
# Testes destrutivos executam apenas em banco separado terminado em _test.
TEST_DATABASE_URL=postgresql://caramelo:CHANGE_ME@127.0.0.1:5432/caramelo_test

# DEMO ONLINE: configure estas variáveis no painel da hospedagem, não neste Git.
# API: NODE_ENV=production, APP_ENV=demo, HOST=0.0.0.0,
# DATABASE_URL do PostgreSQL dedicado em nuvem (banco caramelo_erp),
# WEB_ORIGIN=https://SEU-FRONTEND.vercel.app (origem exata, sem barra final).
APP_ENV=development
DEMO_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
DEMO_SEED_CONFIRM=caramelo_erp
# Somente no build da Vercel; origem HTTPS real da API, sem /api e sem segredo.
DEMO_API_ORIGIN=https://api-demo.example.invalid

# Render demo: declarar explicitamente o banco já criado, sem URL/credenciais aqui.
DEMO_DATABASE_NAME=caramelo_erp
# true somente no primeiro deploy autorizado, depois false.
DEMO_SEED_ON_START=false
